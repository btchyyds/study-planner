# ===== 必需变量 =====
# JWT 签名密钥，≥32 字符随机串，仅控制台注入，禁止入库
JWT_SECRET=

# 运行环境，云端固定 production
FLASK_ENV=production

# SQLite 文件路径，云端用 /var/data/study.db，本地用 study.db
DB_PATH=study.db

# 服务端口，由云平台自动注入，本地兜底 8080
PORT=8080

# ===== 可选变量 =====
# PostgreSQL 连接串，本方案留空走 SQLite
DATABASE_URL=

# 跨域白名单，留空则全开
CORS_ORIGINS=

# 提醒调度间隔（秒），默认 60
SCHEDULER_INTERVAL_SECONDS=60